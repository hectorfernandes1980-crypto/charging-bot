{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "charging-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {"ADMIN_USER_ID": "209708667", "TIME_ZONE": "Europe/Moscow"},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "charging-bot-db",
    "database_id": "REPLACE_WITH_DATABASE_ID",
    "migrations_dir": "migrations"
  }]
}
